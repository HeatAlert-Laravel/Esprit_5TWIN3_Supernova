# Copy once to /opt/heatalert/config/production.env (mode 600); fill private values there.
# Docker Compose reads this file for interpolation; app and mysql receive it at runtime.
APP_NAME=HeatAlert
APP_ENV=production
APP_KEY=GENERATE_ONCE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=http://IP_DE_LA_VM:8088
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=heatalert
DB_USERNAME=heatalert
DB_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_PRIVATE_PASSWORD
SESSION_DRIVER=database
SESSION_COOKIE=heatalert_session
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=heatalert@example.invalid
MAIL_FROM_NAME=HeatAlert
# Optional real SMTP: change MAIL_MAILER and fill these privately.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REQUIRE_TLS=true
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_DAILY_LIMIT=30
GROQ_API_KEY=
GROQ_ASSISTANT_MODEL=openai/gpt-oss-20b
GROQ_ASSISTANT_FALLBACK_MODELS=openai/gpt-oss-120b
GROQ_ASSISTANT_DAILY_LIMIT=100
